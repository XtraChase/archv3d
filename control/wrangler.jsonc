// Wake/status service for the on-demand cloud stream (tells archv3d.com whether the AWS instance is off, asleep,
// starting or running, and starts it when a visitor asks), the site's cookieless visit counter (POST /e) and the admin
// API of the desktop app (/admin/*). Deployed by Cloudflare Workers Builds from this folder (root directory
// "control"). Secrets: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, the access key of the IAM user archv3d-control
// (policy: aws/control-policy.json); ADMIN_TOKEN, shared with the desktop app (Settings > Admin token).
{
  "name": "archv3d-control",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Logs in the dashboard (Workers > archv3d-control > Observability), e.g. a failed AWS API call.
  "observability": { "enabled": true },
  "vars": {
    "AWS_REGION": "us-west-2",
    "INSTANCE_NAME": "archv3d-stream"
  },
  // Visits, contact messages and a small cache (control/src/insights.ts creates the tables).
  "d1_databases": [
    { "binding": "DB", "database_name": "archv3d-insights", "database_id": "d051c863-02a0-461b-941d-5753d45571de" }
  ],
  // Daily: delete visit records older than 13 months and old visitor salts.
  "triggers": { "crons": ["17 9 * * *"] }
}

{
  "name": "archv3d-control",
  "productName": "archv3d Control",
  "description": "Start and stop the archv3d.com stream, watch the site and see who visits.",
  "author": "Chase Richards",
  "private": true,
  "version": "1.0.1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.archv3d.control",
    "productName": "archv3d Control",
    "files": ["electron/**", "dist/**", "build/tray/**"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "archv3d Control",
      "runAfterFinish": true
    }
  }
}

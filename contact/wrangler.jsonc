// Contact form backend for archv3d.com: a Worker that emails each submission to Chase via Cloudflare Email Routing.
// Deployed by Cloudflare Workers Builds from this folder of the GitHub repo (root directory "contact").
// Needs Email Routing enabled on archv3d.com with the destination address below verified.
{
  "name": "archv3d-contact",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Logs in the dashboard (Workers > archv3d-contact > Observability), e.g. a failed send.
  "observability": { "enabled": true },
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "james.chase.richards@gmail.com" }
  ],
  "vars": {
    // Sender on the Email Routing domain; replies go to the visitor (Reply-To).
    "FROM_ADDRESS": "contact@archv3d.com"
  },
  // Each message is also saved here for the desktop app's Messages tab (same database as the control Worker).
  "d1_databases": [
    { "binding": "DB", "database_name": "archv3d-insights", "database_id": "d051c863-02a0-461b-941d-5753d45571de" }
  ]
}
